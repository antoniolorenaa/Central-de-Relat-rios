rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return request.auth.token.email_verified == true; }
    
    function isMaster() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MASTER';
    }

    match /{document=**} {
      allow read, write: if false;
    }
    
    match /accessGrants/{email} {
      allow read: if isSignedIn() && (request.auth.token.email == email || isMaster());
      allow write: if isMaster();
    }
    
    match /brands/{brandId} {
      allow read: if isSignedIn();
      allow write: if isMaster();
    }
    
    match /units/{unitId} {
      allow read: if isSignedIn();
      allow write: if isMaster();
    }
    
    match /gradeLevels/{gradeLevelId} {
      allow read: if isSignedIn();
      allow write: if isMaster();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isMaster());
      allow update: if isMaster() || (isSignedIn() && request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt']));
      allow create: if isSignedIn() && request.auth.uid == userId && (
        (request.resource.data.role == 'MASTER' && request.auth.token.email == "antoniocarloslorena@gmail.com") ||
        (exists(/databases/$(database)/documents/accessGrants/$(request.auth.token.email)) && request.resource.data.role == get(/databases/$(database)/documents/accessGrants/$(request.auth.token.email)).data.role)
      );
    }
  }
}
